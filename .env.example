PORT=3000
NODE_ENV=development

# Подключение к PostgreSQL
DATABASE_URL=postgres://cleanlink:cleanlink_pass@localhost:5432/cleanlink
# true для облачных БД (Render, Railway, Neon, Supabase)
DATABASE_SSL=false

# Секрет для JWT. Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_long_random_string
JWT_EXPIRES_IN=7d

# Первый администратор (создаётся при db:init, если указаны оба поля)
ADMIN_EMAIL=admin@cleanlink.kz
ADMIN_PASSWORD=ChangeMe_Admin123

# true — залить демо-услуги и отзывы из фронтенда
SEED_DEMO=true
